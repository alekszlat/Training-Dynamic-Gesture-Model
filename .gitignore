# Data files
data/manifests/samples.csv
data/manifests/recorded_samples.csv

# Recorded landmarks and metadata are version controlled so sessions merge
# through git. Needs the "/*" form: git will not descend into a directory
# excluded with a trailing slash, so the negations below would do nothing.
data/interim/*
!data/interim/landmarks/
data/interim/landmarks/*
!data/interim/landmarks/recorded/

!data/processed/recorded_metadata.csv
